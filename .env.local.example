# Copy this file to .env.local for Expo development.
# Restart Expo after changing EXPO_PUBLIC_* values.
#
# For the iOS simulator on the same Mac, 127.0.0.1 can work.
# For a physical phone, use your computer's LAN IP and run Django on 0.0.0.0:8000.

EXPO_PUBLIC_TWIRLMATE_RUNTIME_ENV=local
EXPO_PUBLIC_TWIRLMATE_API_ORIGIN=http://192.168.1.10:8000
EXPO_PUBLIC_TWIRLMATE_WEB_ORIGIN=http://192.168.1.10:8000
EXPO_PUBLIC_TWIRLMATE_MOBILE_API_BASE_PATH=/api/v1/mobile
